page "Hello, Arc"
  header
    heading "Hello, Arc"
    text "Built from scratch. Zero dependencies. Zero runtime."

  main
    card
      heading "What is Arc?"
      text "Arc is a new language for the web. Write Arc — ship optimal HTML, CSS, and JS."

    row
      card
        heading "Zero JS"
        text "Static pages ship with 0 bytes of JavaScript."

      card
        heading "Tiny CSS"
        text "Only the CSS your components actually use."

      card
        heading "Fast"
        text "Compiles to the fastest possible output for every browser."

  footer
    text "Arc — a new language for the web."
