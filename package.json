{
  "name": "@arc-lang/arc",
  "version": "0.2.2",
  "description": "Arc — a full-stack language for the web. Compiles to optimal HTML/CSS/JS (frontend) and Bun/Cloudflare Workers servers (backend). Zero runtime, zero dependencies.",
  "main": "src/cli.js",
  "bin": {
    "arc": "src/cli.js",
    "create-arc-web": "src/create-arc-web.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arc-language/arc-web.git"
  },
  "homepage": "https://github.com/arc-language/arc-web#readme",
  "bugs": {
    "url": "https://github.com/arc-language/arc-web/issues"
  },
  "author": "Arc contributors",
  "files": [
    "src",
    "stdlib",
    "adp",
    "docs",
    ".claude/skills",
    "editor-extensions/llm-skills",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "scripts": {
    "test": "node --test 'tests/**/*.test.js'",
    "test:coverage": "node --test --experimental-test-coverage 'tests/**/*.test.js'",
    "lint": "find src adp tests -name '*.js' | xargs node --check",
    "build": "node src/cli.js build",
    "build-site": "node src/cli.js build-site",
    "dev": "node src/cli.js dev",
    "start": "node src/cli.js dev",
    "skills:build": "bash scripts/build-llm-skills.sh"
  },
  "keywords": [
    "arc",
    "arc-language",
    "compiler",
    "web",
    "html",
    "css",
    "javascript",
    "static-site-generator",
    "edge",
    "edge-rendering",
    "cloudflare-workers",
    "jamstack",
    "zero-dependency",
    "zero-runtime",
    "web-framework"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "sideEffects": false,
  "optionalDependencies": {
    "better-sqlite3": "^9.6.0",
    "pg": "^8.0.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0"
  }
}
