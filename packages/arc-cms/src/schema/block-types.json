{
  "_styleFields": [
    { "name": "padding",    "type": "text",   "label": "Padding",         "placeholder": "e.g. 80px 24px" },
    { "name": "background", "type": "text",   "label": "Background",      "placeholder": "color or url(...)" },
    { "name": "textColor",  "type": "text",   "label": "Text color",      "placeholder": "#0a0a0a" },
    { "name": "align",      "type": "select", "label": "Align",           "options": ["left", "center", "right"] },
    { "name": "maxWidth",   "type": "text",   "label": "Max width",       "placeholder": "e.g. 720px" }
  ],
  "hero": {
    "label": "Hero",
    "description": "Full-width hero with heading, subtitle, CTA button",
    "fields": [
      { "name": "title",    "type": "text",     "label": "Title",     "required": true },
      { "name": "subtitle", "type": "textarea", "label": "Subtitle" },
      { "name": "ctaLabel", "type": "text",     "label": "CTA label" },
      { "name": "ctaHref",  "type": "url",      "label": "CTA href" }
    ]
  },
  "features": {
    "label": "Features",
    "description": "Grid of feature cards with icon, title, body",
    "fields": [
      { "name": "heading", "type": "text",  "label": "Section heading" },
      { "name": "items",   "type": "array", "label": "Items",
        "of": { "icon": "text", "title": "text", "body": "textarea" } }
    ]
  },
  "text": {
    "label": "Text",
    "description": "Rich text content block with optional heading",
    "fields": [
      { "name": "heading", "type": "text",     "label": "Heading" },
      { "name": "body",    "type": "textarea", "label": "Body",    "required": true }
    ]
  },
  "cta": {
    "label": "Call to Action",
    "description": "Centered section with headline and primary button",
    "fields": [
      { "name": "heading",     "type": "text", "label": "Heading",      "required": true },
      { "name": "buttonLabel", "type": "text", "label": "Button label" },
      { "name": "buttonHref",  "type": "url",  "label": "Button href" }
    ]
  },
  "code": {
    "label": "Code Block",
    "description": "Syntax-highlighted code sample",
    "fields": [
      { "name": "language", "type": "select",   "label": "Language",
        "options": ["js", "ts", "arc", "python", "rust", "html", "css", "bash"] },
      { "name": "source",   "type": "textarea", "label": "Source", "mono": true, "required": true }
    ]
  },
  "faq": {
    "label": "FAQ",
    "description": "Accordion of question / answer pairs",
    "fields": [
      { "name": "items", "type": "array", "label": "Q&A",
        "of": { "question": "text", "answer": "textarea" } }
    ]
  }
}
