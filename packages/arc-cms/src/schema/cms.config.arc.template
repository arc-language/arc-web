# cms.config.arc — site-level CMS configuration.
# Declare custom block types here; they merge with the defaults in
# server/block-types.json (hero, features, text, cta, code, faq).
#
# Example:
#
#   cms
#     blockType "pricing"
#       label "Pricing table"
#       field "headline"  : String
#       field "tiers"     : Array of { name: String, price: String, features: Array of String }
#
#     branding
#       name "My Site Admin"
#       primary "#5b8cff"
