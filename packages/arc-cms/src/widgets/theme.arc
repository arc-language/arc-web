# arc-cms admin theme.
# Edit these tokens to brand your admin panel.
# Both arc-ui components and arc-cms layouts pick this up automatically.
#
# Where else can I set these? Any :root in any design block on the page.
# DOM-scoped overrides work too (e.g. for per-section themes).
design
  :root
    --brand-from: #00e5ff
    --brand-to: #7b2fff
    --brand-accent: #005fcc
    @dark
      --brand-accent: #00e5ff
