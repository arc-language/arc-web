# CmsLayout - admin panel chrome.
widget CmsLayout(title: String, active: String)
  @raw '<script>(function(){try{var t=localStorage.getItem("cms_theme");if(t==="dark"||t==="light"){document.documentElement.setAttribute("data-theme",t)}var l=localStorage.getItem("cms_locale");if(l)document.documentElement.setAttribute("lang",l)}catch(e){}})();</script>'
  @raw '<link rel="stylesheet" href="/arc-ui/arc-ui.css">'
  @raw '<style>:root{--brand-from:#00e5ff;--brand-to:#7b2fff;--brand-accent:#7b2fff;--ui-bg:#f0f7ff;--ui-bg-2:#e4eeff;--ui-bg-3:#dae8ff;--ui-fg:#050d1f;--ui-fg-2:#1e3a5f;--ui-fg-3:#4a6080;--ui-border:rgba(123,47,255,0.28);--ui-accent:#7b2fff;--ui-accent-glass:rgba(123,47,255,0.12);--ui-error:#dc2626;--ui-error-glass:rgba(220,38,38,0.10);--glass-bg:rgba(123,47,255,0.07);--glass-bg-hover:rgba(123,47,255,0.13);--glass-bg-active:rgba(123,47,255,0.19);--glass-border:rgba(123,47,255,0.32);--glass-blur:18px;--glass-saturate:180%;--glass-specular:linear-gradient(135deg,rgba(255,255,255,0.60) 0%,rgba(255,255,255,0) 60%);--dropdown-bg:rgba(240,247,255,0.96)}@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--brand-accent:#00e5ff;--ui-bg:#03040f;--ui-bg-2:#080c1a;--ui-bg-3:#0e1428;--ui-fg:#edf4ff;--ui-fg-2:#8ba8d4;--ui-fg-3:#3d5475;--ui-border:rgba(0,229,255,0.12);--ui-accent:#00e5ff;--ui-accent-glass:rgba(0,229,255,0.12);--ui-error:#f87171;--ui-error-glass:rgba(248,113,113,0.14);--glass-bg:rgba(255,255,255,0.04);--glass-bg-hover:rgba(0,229,255,0.08);--glass-bg-active:rgba(0,229,255,0.13);--glass-border:rgba(0,229,255,0.18);--glass-specular:linear-gradient(135deg,rgba(255,255,255,0.08) 0%,rgba(255,255,255,0) 60%);--dropdown-bg:rgba(14,20,40,0.86)}}:root[data-theme="dark"]{--brand-accent:#00e5ff;--ui-bg:#03040f;--ui-bg-2:#080c1a;--ui-bg-3:#0e1428;--ui-fg:#edf4ff;--ui-fg-2:#8ba8d4;--ui-fg-3:#3d5475;--ui-border:rgba(0,229,255,0.12);--ui-accent:#00e5ff;--ui-accent-glass:rgba(0,229,255,0.12);--ui-error:#f87171;--ui-error-glass:rgba(248,113,113,0.14);--glass-bg:rgba(255,255,255,0.04);--glass-bg-hover:rgba(0,229,255,0.08);--glass-bg-active:rgba(0,229,255,0.13);--glass-border:rgba(0,229,255,0.18);--glass-specular:linear-gradient(135deg,rgba(255,255,255,0.08) 0%,rgba(255,255,255,0) 60%);--dropdown-bg:rgba(14,20,40,0.86)}.dropdown__menu{border-color:var(--glass-border)!important;color:var(--ui-fg)}.dropdown__item{color:var(--ui-fg)}.dropdown__item:hover{background:var(--glass-bg-hover)!important}.dropdown__separator{background:var(--glass-border)}.dropdown__label{color:var(--ui-fg-3)}</style>'
  @raw '<script src="/arc-ui/js/toast.js" defer></script>'
  @raw '<style>.nav-sidebar{background:rgba(0,95,204,0.08)!important;border:1.5px solid rgba(0,95,204,0.25)!important;box-shadow:inset 0 1px 0 rgba(255,255,255,0.6),0 4px 24px rgba(0,95,204,0.10)!important}.nav-sidebar__mark{background:none!important;box-shadow:none!important;border-radius:0!important}.nav-sidebar::before{background:none!important}.nav-topbar{background:rgba(0,95,204,0.08)!important;backdrop-filter:none!important;-webkit-backdrop-filter:none!important;border:1.5px solid rgba(0,95,204,0.25)!important;box-shadow:inset 0 1px 0 rgba(255,255,255,0.6)!important}body{background:#fff!important}body[data-role="viewer"] .cms-role-admin,body[data-role="viewer"] .cms-role-editor,body[data-role="editor"] .cms-role-admin{display:none!important}.cms-search-trigger{display:flex;align-items:center;gap:10px;padding:7px 12px;min-width:220px;max-width:320px;background:var(--glass-bg);border:1px solid var(--ui-border,rgba(0,0,0,.08));border-radius:10px;color:var(--ui-fg-3,var(--ui-fg-2));cursor:pointer;font-family:inherit;font-size:13px;transition:border-color .15s,background-color .15s,color .15s}.cms-search-trigger:hover{border-color:var(--ui-accent);background:var(--ui-bg-2);color:var(--ui-fg-2)}.cms-search-trigger:focus-visible{outline:2px solid var(--ui-accent);outline-offset:2px}.cms-search-icon{font-weight:800;letter-spacing:.04em}.cms-search-label{flex:1;text-align:left}.cms-search-foot{display:flex;align-items:center;gap:14px;padding:8px 14px;border-top:1px solid rgba(255,255,255,.08);font-size:11px;color:rgba(255,255,255,.55)}.cms-search-foot .kbd{font-size:10px;padding:1px 5px}.cms-search-hint{padding:40px 18px;text-align:center;font-size:13px;color:rgba(255,255,255,.5)}.cms-search-spinner{flex-shrink:0;margin-right:14px}.cms-theme-toggle{overflow:visible!important;position:relative}.cms-theme-svg{transition:transform .5s cubic-bezier(.34,1.56,.64,1);overflow:visible}.cms-theme-toggle:hover .cms-theme-svg{transform:rotate(28deg) scale(1.08)}.cms-theme-toggle:active .cms-theme-svg{transform:rotate(-12deg) scale(.95);transition-duration:.15s}.cms-theme-sun,.cms-theme-rays,.cms-theme-moon{transform-origin:12px 12px;transition:transform .55s cubic-bezier(.34,1.56,.64,1),opacity .35s ease,fill .35s ease,stroke .35s ease}.cms-theme-rays line{transition:transform .55s cubic-bezier(.34,1.56,.64,1);transform-origin:12px 12px}.cms-theme-toggle[data-mode="light"] .cms-theme-sun{fill:#FFB422;stroke:#FFB422;transform:scale(1)}.cms-theme-toggle[data-mode="light"] .cms-theme-rays{opacity:1;transform:scale(1) rotate(0)}.cms-theme-toggle[data-mode="light"] .cms-theme-rays line{stroke:#FFB422}.cms-theme-toggle[data-mode="light"] .cms-theme-moon{transform:translate(28px,-28px) rotate(90deg) scale(.4);opacity:0;fill:transparent;stroke:transparent}.cms-theme-toggle[data-mode="dark"] .cms-theme-sun{transform:scale(0);opacity:0;fill:transparent;stroke:transparent}.cms-theme-toggle[data-mode="dark"] .cms-theme-rays{opacity:0;transform:scale(.3) rotate(-90deg)}.cms-theme-toggle[data-mode="dark"] .cms-theme-moon{transform:translate(0,0) rotate(0) scale(1);opacity:1;fill:#B8C5FF;stroke:#B8C5FF}.cms-theme-toggle[data-mode="auto"] .cms-theme-sun{fill:#7B96FF;stroke:#7B96FF;transform:scale(.55) translateX(-3px)}.cms-theme-toggle[data-mode="auto"] .cms-theme-rays{opacity:.4;transform:scale(.7) rotate(20deg)}.cms-theme-toggle[data-mode="auto"] .cms-theme-rays line{stroke:#7B96FF}.cms-theme-toggle[data-mode="auto"] .cms-theme-moon{transform:translate(4px,-2px) scale(.6);opacity:.85;fill:#9EB3FF;stroke:#9EB3FF}.cms-theme-mode{position:absolute;bottom:3px;right:3px;width:6px;height:6px;border-radius:999px;box-shadow:0 0 0 1.5px var(--ui-bg-2,#fff);transition:background .35s ease;pointer-events:none}.cms-theme-toggle[data-mode="light"] .cms-theme-mode{background:#FFB422;box-shadow:0 0 0 1.5px var(--ui-bg-2,#fff),0 0 8px rgba(255,180,34,.5)}.cms-theme-toggle[data-mode="dark"] .cms-theme-mode{background:#B8C5FF;box-shadow:0 0 0 1.5px var(--ui-bg-2,#fff),0 0 8px rgba(184,197,255,.5)}.cms-theme-toggle[data-mode="auto"] .cms-theme-mode{background:linear-gradient(135deg,#FFB422 0%,#FFB422 49%,#B8C5FF 51%,#B8C5FF 100%)}.cms-lang-trigger{display:inline-flex;align-items:center;gap:8px;height:36px;padding:0 10px 0 6px!important;width:auto!important;min-width:0!important;font-size:11px;font-weight:700;letter-spacing:.04em;color:var(--ui-fg-2)}.cms-lang-trigger .cms-lang-flag--trigger{display:none}.cms-lang-trigger[data-locale="en"] .cms-lang-flag--trigger[data-flag="en"],.cms-lang-trigger[data-locale="es"] .cms-lang-flag--trigger[data-flag="es"],.cms-lang-trigger[data-locale="fr"] .cms-lang-flag--trigger[data-flag="fr"],.cms-lang-trigger[data-locale="nl"] .cms-lang-flag--trigger[data-flag="nl"],.cms-lang-trigger[data-locale="de"] .cms-lang-flag--trigger[data-flag="de"]{display:inline-flex}.cms-lang-flag{display:inline-flex;align-items:center;justify-content:center;width:22px;height:16px;border-radius:3px;background:var(--ui-bg-3,#f5f5f5);box-shadow:0 0 0 1px rgba(0,0,0,.12),0 1px 2px rgba(0,0,0,.06);overflow:hidden;flex-shrink:0}.cms-lang-flag svg{width:100%;height:100%;display:block}.cms-lang-code{font-size:11px;font-weight:700;letter-spacing:.04em;color:var(--ui-fg)}.cms-lang-caret{color:var(--ui-fg-3,var(--ui-fg-2));transition:transform .2s ease;flex-shrink:0;margin-left:-2px}.cms-lang[open] .cms-lang-caret{transform:rotate(180deg)}.cms-lang-item{display:flex!important;align-items:center;gap:12px;padding:8px 10px 8px 8px!important;border-radius:8px}.cms-lang-item .cms-lang-flag{width:24px;height:18px;border-radius:3px}.cms-lang-name{flex:1;font-size:13px;font-weight:500;color:var(--ui-fg);text-align:left}.cms-lang-check{color:var(--ui-accent);opacity:0;transform:scale(.6);transition:opacity .15s ease,transform .25s cubic-bezier(.34,1.56,.64,1);flex-shrink:0}.cms-lang-item[aria-checked="true"]{background:var(--ui-accent-glass,rgba(89,86,240,.08))}.cms-lang-item[aria-checked="true"] .cms-lang-name{color:var(--ui-accent);font-weight:600}.cms-lang-item[aria-checked="true"] .cms-lang-check{opacity:1;transform:scale(1)}.cms-lang-item:focus-visible{outline:2px solid var(--ui-accent);outline-offset:-2px}.cms-notif-trigger{position:relative}.cms-notif-bell{transition:transform .25s cubic-bezier(.34,1.56,.64,1);transform-origin:12px 4px}.cms-notif-trigger:hover .cms-notif-bell{transform:rotate(-12deg)}.cms-notif.has-unread .cms-notif-bell{animation:cms-bell-ring 1.6s ease-in-out 1;color:var(--ui-accent)}@keyframes cms-bell-ring{0%,100%{transform:rotate(0)}10%,30%{transform:rotate(-14deg)}20%,40%{transform:rotate(14deg)}50%{transform:rotate(-6deg)}60%{transform:rotate(4deg)}70%{transform:rotate(0)}}.cms-notif-badge{position:absolute!important;top:1px;right:1px;min-width:18px;height:18px;padding:0 5px!important;font-size:10px!important;font-weight:800;color:#fff;background:linear-gradient(135deg,#ff4757,#ff2e2e)!important;border:none!important;box-shadow:0 0 0 2px var(--ui-bg-2,#fff),0 2px 6px rgba(255,46,46,.35);line-height:1!important;animation:cms-badge-pop .35s cubic-bezier(.34,1.56,.64,1)}@keyframes cms-badge-pop{0%{transform:scale(0);opacity:0}60%{transform:scale(1.2)}100%{transform:scale(1);opacity:1}}.cms-notif-panel{width:360px;max-height:480px;padding:0!important;display:flex;flex-direction:column}.cms-notif-head{display:flex!important;align-items:center;justify-content:space-between;gap:12px;padding:14px 14px 12px!important;border-bottom:1px solid var(--ui-border,rgba(0,0,0,.08));margin:0!important}.cms-notif-head-left{display:flex;align-items:center;gap:8px}.cms-notif-title{font-size:13px;font-weight:700;color:var(--ui-fg);letter-spacing:-.005em}.cms-notif-count{display:inline-flex;align-items:center;justify-content:center;min-width:18px;height:18px;padding:0 6px;font-size:10px;font-weight:700;color:#fff;background:linear-gradient(135deg,#ff4757,#ff2e2e);border-radius:999px}.cms-notif-mark-read{font-size:11px;font-weight:600;color:var(--ui-accent);background:none;border:none;cursor:pointer;padding:4px 6px;border-radius:6px;font-family:inherit;transition:background-color .15s ease}.cms-notif-mark-read:hover{background:var(--ui-accent-glass,rgba(89,86,240,.08))}.cms-notif-mark-read:focus-visible{outline:2px solid var(--ui-accent);outline-offset:1px}.cms-notif-list{flex:1;overflow-y:auto;padding:6px;min-height:100px;scrollbar-width:thin}.cms-notif-list::-webkit-scrollbar{width:6px}.cms-notif-list::-webkit-scrollbar-thumb{background:var(--ui-border,rgba(0,0,0,.12));border-radius:3px}.cms-notif-item{display:flex;align-items:flex-start;gap:10px;padding:10px 12px 10px 14px;border-radius:8px;font-size:12px;color:var(--ui-fg-2);text-decoration:none;position:relative;transition:background-color .15s ease,transform .15s ease}.cms-notif-item:hover{background:var(--glass-bg);transform:translateX(2px)}.cms-notif-item.is-unread{background:var(--ui-accent-glass,rgba(89,86,240,.05))}.cms-notif-item.is-unread::before{content:"";position:absolute;left:5px;top:50%;transform:translateY(-50%);width:6px;height:6px;border-radius:999px;background:var(--ui-accent);box-shadow:0 0 0 3px var(--ui-accent-glass,rgba(89,86,240,.18))}.cms-notif-item-body{flex:1;display:flex;flex-direction:column;gap:4px;min-width:0}.cms-notif-item-row{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.cms-notif-action{display:inline-flex;align-items:center;gap:4px;font-size:9px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;padding:3px 7px;border-radius:4px;background:rgba(100,116,139,.12);color:#475569;line-height:1}.cms-notif-action[data-kind="create"]{background:rgba(34,197,94,.14);color:#16a34a}.cms-notif-action[data-kind="update"]{background:rgba(59,130,246,.14);color:#2563eb}.cms-notif-action[data-kind="delete"]{background:rgba(239,68,68,.14);color:#dc2626}.cms-notif-action[data-kind="auth"]{background:rgba(168,85,247,.14);color:#9333ea}.cms-notif-entity{font-weight:600;color:var(--ui-fg);font-size:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0;flex:1}.cms-notif-time{font-size:10px;color:var(--ui-fg-3,var(--ui-fg-2));font-variant-numeric:tabular-nums;flex-shrink:0}.cms-notif-empty{padding:36px 14px 32px;text-align:center;display:flex;flex-direction:column;align-items:center;gap:8px;color:var(--ui-fg-3,var(--ui-fg-2))}.cms-notif-empty svg{opacity:.35}.cms-notif-empty-title{font-size:13px;font-weight:600;color:var(--ui-fg-2);margin-top:4px}.cms-notif-empty-sub{font-size:11px;color:var(--ui-fg-3,var(--ui-fg-2))}.cms-notif-skel{padding:8px;display:flex;flex-direction:column;gap:6px}.cms-notif-view-all{display:flex;align-items:center;justify-content:center;gap:4px;padding:10px;border-top:1px solid var(--ui-border,rgba(0,0,0,.08));font-size:11px;font-weight:600;color:var(--ui-accent);text-decoration:none;transition:background-color .15s ease}.cms-notif-view-all:hover{background:var(--ui-accent-glass,rgba(89,86,240,.06))}.cms-notif-view-all svg{transition:transform .2s ease}.cms-notif-view-all:hover svg{transform:translateX(2px)}.cms-user-trigger{padding:2px!important;border-radius:999px;transition:background-color .15s,box-shadow .2s;position:relative}.cms-user-trigger:hover{background:var(--glass-bg-hover,var(--glass-bg))}.cms-user[open] .cms-user-trigger{box-shadow:0 0 0 2px var(--ui-accent-glass)}.cms-user-avatar{--avatar-size:32px;background:linear-gradient(135deg,var(--brand-from,#00e5ff),var(--brand-to,#7b2fff))!important;color:#020309!important;font-weight:800;text-transform:uppercase;letter-spacing:-.02em}.cms-user-status{position:absolute;bottom:1px;right:1px;width:10px;height:10px;border-radius:999px;background:#22c55e;box-shadow:0 0 0 2px var(--ui-bg-2,#fff);pointer-events:none}.cms-user-status::after{content:"";position:absolute;inset:-2px;border-radius:inherit;background:#22c55e;opacity:.4;animation:cms-status-pulse 2s ease-in-out infinite}@keyframes cms-status-pulse{0%,100%{transform:scale(1);opacity:.4}50%{transform:scale(1.4);opacity:0}}.cms-user-panel{padding:0!important;width:280px;overflow:hidden}.cms-user-header{display:flex;align-items:center;gap:12px;padding:14px 14px 14px;background:linear-gradient(135deg,var(--ui-accent-glass) 0%,transparent 100%);border-bottom:1px solid var(--glass-border,var(--ui-border));position:relative}.cms-user-header::after{content:"";position:absolute;left:14px;right:14px;bottom:0;height:1px;background:linear-gradient(90deg,transparent,var(--ui-accent),transparent);opacity:.3}.cms-user-avatar-lg{--avatar-size:44px;background:linear-gradient(135deg,var(--brand-from,#00e5ff),var(--brand-to,#7b2fff))!important;color:#020309!important;font-weight:800;text-transform:uppercase;letter-spacing:-.02em;flex-shrink:0;font-size:16px;box-shadow:0 4px 12px rgba(0,229,255,.25),0 0 0 2px rgba(255,255,255,.4)}.cms-user-meta{flex:1;min-width:0;display:flex;flex-direction:column;gap:1px}.cms-user-name{font-size:13.5px;font-weight:700;color:var(--ui-fg);letter-spacing:-.005em;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.cms-user-email{font-size:11px;color:var(--ui-fg-3,var(--ui-fg-2));overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.cms-user-role{display:inline-flex;align-items:center;gap:4px;align-self:flex-start;margin-top:5px;padding:2px 7px;font-size:9px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;border-radius:4px;line-height:1.4;background:var(--ui-accent-glass);color:var(--ui-accent)}.cms-user-role::before{content:"";display:inline-block;width:5px;height:5px;border-radius:999px;background:currentColor}.cms-user-role[data-role="admin"]{background:rgba(220,38,38,.12);color:#dc2626}.cms-user-role[data-role="editor"]{background:rgba(59,130,246,.12);color:#2563eb}.cms-user-role[data-role="viewer"]{background:rgba(100,116,139,.14);color:#475569}.cms-user-section{padding:6px}.cms-user-section-label{display:block;padding:8px 8px 4px!important;font-size:9.5px!important;letter-spacing:.1em!important}.cms-user-item{display:flex!important;align-items:center;gap:10px;padding:0 10px!important;height:34px!important;border-radius:7px;font-size:13px;font-weight:500;transition:background-color .12s ease,transform .12s ease}.cms-user-item:hover{background:var(--glass-bg-hover,var(--glass-bg))!important;transform:translateX(2px)}.cms-user-item:focus-visible{outline:2px solid var(--ui-accent);outline-offset:-2px}.cms-user-icon{flex-shrink:0;color:var(--ui-fg-3,var(--ui-fg-2));transition:color .12s ease}.cms-user-item:hover .cms-user-icon{color:var(--ui-accent)}.cms-user-signout:hover .cms-user-icon{color:var(--ui-error,#dc2626)}.cms-user-ext{margin-left:auto;color:var(--ui-fg-3,var(--ui-fg-2));opacity:.55;flex-shrink:0;transition:opacity .15s ease,transform .15s ease}.cms-user-item:hover .cms-user-ext{opacity:1;transform:translate(1px,-1px)}.cms-user-signout{margin:0 6px 6px;border-radius:7px!important;height:34px!important;padding:0 10px!important}@media (max-width:720px){.cms-search-trigger{min-width:0;max-width:none;padding:7px 10px}}</style>'
  @raw '<div class="command-backdrop" id="cms-search-backdrop"><div class="command" role="dialog" aria-modal="true" aria-label="Search"><div class="command__search"><span class="command__search-icon" aria-hidden="true">S</span><input class="command__input" id="cms-search-input" type="text" placeholder="Search pages, blocks, users, media..." autocomplete="off" spellcheck="false" autocapitalize="off"><span class="spinner cms-search-spinner" id="cms-search-spinner" hidden aria-hidden="true" style="width:14px;height:14px"></span></div><div class="command__list" id="cms-search-results" role="listbox"><div class="cms-search-hint" id="cms-search-hint">Start typing to search</div></div><div class="cms-search-foot"><span><kbd class="kbd">UP</kbd> <kbd class="kbd">DN</kbd> navigate</span><span><kbd class="kbd">ENTER</kbd> open</span><span><kbd class="kbd">ESC</kbd> close</span></div></div></div>'
  @raw '<script>document.addEventListener("DOMContentLoaded",function(){var TH={KEY:"cms_theme"};function applyTheme(t){var mode=t==="light"||t==="dark"?t:"auto";if(mode==="auto"){document.documentElement.removeAttribute("data-theme")}else{document.documentElement.setAttribute("data-theme",mode)}var btn=document.getElementById("cms-theme-toggle");if(btn){btn.title="Theme: "+mode+" (click to cycle)";btn.setAttribute("data-mode",mode);btn.setAttribute("aria-label","Toggle theme (current: "+mode+")")}}var saved=null;try{saved=localStorage.getItem(TH.KEY)}catch(e){}applyTheme(saved||"auto");var tbtn=document.getElementById("cms-theme-toggle");if(tbtn){tbtn.addEventListener("click",function(){var cur=null;try{cur=localStorage.getItem(TH.KEY)}catch(e){}var next=cur==="light"?"dark":cur==="dark"?null:"light";try{if(next){localStorage.setItem(TH.KEY,next)}else{localStorage.removeItem(TH.KEY)}}catch(e){}applyTheme(next)})}var savedLoc="en";try{savedLoc=localStorage.getItem("cms_locale")||"en"}catch(e){}var lt=document.getElementById("cms-lang-trigger");if(lt)lt.setAttribute("data-locale",savedLoc);var lc=document.getElementById("cms-lang-current");if(lc)lc.textContent=savedLoc.toUpperCase();var langItems=document.querySelectorAll(".cms-lang-item");langItems.forEach(function(b,i){var on=b.dataset.locale===savedLoc;b.setAttribute("aria-checked",on?"true":"false");b.setAttribute("tabindex",on?"0":"-1");b.addEventListener("click",function(){var loc=b.dataset.locale;try{localStorage.setItem("cms_locale",loc)}catch(e){}document.cookie="lang="+loc+"; path=/; max-age=31536000; SameSite=Lax";document.documentElement.setAttribute("lang",loc);location.reload()});b.addEventListener("keydown",function(ev){if(ev.key==="ArrowDown"||ev.key==="ArrowUp"){ev.preventDefault();var d=ev.key==="ArrowDown"?1:-1;var next=langItems[(i+d+langItems.length)%langItems.length];if(next)next.focus()}else if(ev.key==="Home"){ev.preventDefault();langItems[0].focus()}else if(ev.key==="End"){ev.preventDefault();langItems[langItems.length-1].focus()}})});var langDetails=document.querySelector(".cms-lang");if(langDetails){langDetails.addEventListener("toggle",function(){if(langDetails.open){var checked=langDetails.querySelector(\'[aria-checked="true"]\')||langItems[0];if(checked)setTimeout(function(){checked.focus()},0)}})}document.addEventListener("click",function(ev){document.querySelectorAll("details.dropdown[open]").forEach(function(d){if(!d.contains(ev.target))d.removeAttribute("open")})});document.addEventListener("keydown",function(ev){if(ev.key==="Escape"){document.querySelectorAll("details.dropdown[open]").forEach(function(d){d.removeAttribute("open")})}});fetch("/admin/check-auth",{headers:{Accept:"application/json"},redirect:"manual"}).then(function(r){if(!r||r.status===401||r.type==="opaqueredirect"||r.status===0){location.replace("/admin/login");return null}return r.json().catch(function(){return{}})}).then(function(j){if(!j)return;if(j.role){document.body.setAttribute("data-role",j.role);if(j.role!=="admin"&&location.pathname!=="/admin/403"){location.replace("/admin/403");return;}}var name=j.name||(j.email||"").split("@")[0]||"User";var initials=(name.match(/\\b\\w/g)||["?"]).slice(0,2).join("").toUpperCase();var av=document.getElementById("cms-user-avatar");if(av)av.textContent=initials;var avLg=document.getElementById("cms-user-avatar-lg");if(avLg)avLg.textContent=initials;var nm=document.getElementById("cms-user-menu-name");if(nm)nm.textContent=name;var em=document.getElementById("cms-user-menu-email");if(em)em.textContent=j.email||"";var rb=document.getElementById("cms-user-menu-role");if(rb&&j.role){rb.textContent=j.role;rb.setAttribute("data-role",j.role);rb.hidden=false}});function kindFor(a){a=(a||"").toLowerCase();if(a.indexOf("creat")===0||a==="add"||a==="register")return"create";if(a.indexOf("updat")===0||a==="edit"||a==="rename"||a==="publish")return"update";if(a.indexOf("delet")===0||a==="remove"||a==="archive")return"delete";if(a==="login"||a==="logout"||a==="signin"||a==="signout")return"auth";return""}function relTime(t){var ago=Math.floor((Date.now()-t)/1000);if(ago<10)return"just now";if(ago<60)return ago+"s ago";var m=Math.floor(ago/60);if(m<60)return m+"m ago";var h=Math.floor(m/60);if(h<24)return h+"h ago";var d=Math.floor(h/24);if(d<7)return d+"d ago";return new Date(t).toLocaleDateString()}function escapeHtml(s){return String(s==null?"":s).replace(/[&<>"\']/g,function(c){return{"&":"&amp;","<":"&lt;",">":"&gt;","\\"":"&quot;","\'":"&#39;"}[c]})}function loadNotifs(){fetch("/admin/api/notifications",{headers:{Accept:"application/json"}}).then(function(r){return r.ok?r.json():{entries:[]}}).then(function(j){var root=document.getElementById("cms-notif");var list=document.getElementById("cms-notif-list");var badge=document.getElementById("cms-notif-badge");var count=document.getElementById("cms-notif-count");var markBtn=document.getElementById("cms-notif-mark-read");if(!list||!root)return;var seen=0;try{seen=+localStorage.getItem("cms_notif_seen_at")||0}catch(e){}var entries=j.entries||[];var unread=entries.filter(function(e){return new Date(e.at).getTime()>seen}).length;if(unread>0){root.classList.add("has-unread")}else{root.classList.remove("has-unread")}if(badge){if(unread>0){badge.textContent=unread>9?"9+":String(unread);badge.hidden=false}else{badge.hidden=true}}if(count){if(unread>0){count.textContent=unread+" new";count.hidden=false}else{count.hidden=true}}if(markBtn){markBtn.hidden=unread===0}if(entries.length===0){list.innerHTML=\'<div class="cms-notif-empty"><svg viewBox="0 0 48 48" width="40" height="40" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16a12 12 0 0 1 24 0c0 14 6 18 6 18H6s6-4 6-18"/><path d="M20.5 42a3.88 3.88 0 0 0 7 0"/><circle cx="36" cy="12" r="4" fill="currentColor" opacity=".3"/></svg><div class="cms-notif-empty-title">All caught up</div><div class="cms-notif-empty-sub">No recent activity to show</div></div>\';return}list.innerHTML=entries.map(function(e){var t=new Date(e.at).getTime();var when=relTime(t);var kind=kindFor(e.action);var unr=t>seen;var entity=escapeHtml(e.entityType||"")+(e.entityId?" #"+escapeHtml(e.entityId):"");return \'<div class="cms-notif-item\'+(unr?" is-unread":"")+\'"><div class="cms-notif-item-body"><div class="cms-notif-item-row"><span class="cms-notif-action" data-kind="\'+kind+\'">\'+escapeHtml(e.action||"event")+\'</span><span class="cms-notif-entity">\'+entity+\'</span></div></div><span class="cms-notif-time">\'+when+\'</span></div>\'}).join("")}).catch(function(){var list=document.getElementById("cms-notif-list");if(list)list.innerHTML=\'<div class="cms-notif-empty"><div class="cms-notif-empty-title">Couldn&rsquo;t load activity</div><div class="cms-notif-empty-sub">Try again in a moment</div></div>\'})}loadNotifs();function markAllRead(){try{localStorage.setItem("cms_notif_seen_at",String(Date.now()))}catch(e){}var b=document.getElementById("cms-notif-badge");if(b)b.hidden=true;var c=document.getElementById("cms-notif-count");if(c)c.hidden=true;var m=document.getElementById("cms-notif-mark-read");if(m)m.hidden=true;var r=document.getElementById("cms-notif");if(r)r.classList.remove("has-unread");document.querySelectorAll(".cms-notif-item.is-unread").forEach(function(el){el.classList.remove("is-unread")})}var markBtn=document.getElementById("cms-notif-mark-read");if(markBtn)markBtn.addEventListener("click",function(ev){ev.stopPropagation();markAllRead()});var nbtn=document.getElementById("cms-notif");if(nbtn){nbtn.addEventListener("toggle",function(){if(nbtn.open){var b=document.getElementById("cms-notif-badge");if(b)b.hidden=true}else{markAllRead()}})}var backdrop=document.getElementById("cms-search-backdrop");var input=document.getElementById("cms-search-input");var results=document.getElementById("cms-search-results");var trigger=document.getElementById("cms-search-trigger");var spinner=document.getElementById("cms-search-spinner");var hint=document.getElementById("cms-search-hint");var selectedIdx=0;var currentItems=[];function openPalette(){if(!backdrop)return;backdrop.classList.add("is-open");if(input){input.value="";input.focus()}if(results)results.innerHTML=\'<div class="cms-search-hint">Start typing to search</div>\';currentItems=[]}function closePalette(){if(!backdrop)return;backdrop.classList.remove("is-open")}if(trigger)trigger.addEventListener("click",openPalette);if(backdrop)backdrop.addEventListener("click",function(ev){if(ev.target===backdrop)closePalette()});document.addEventListener("keydown",function(ev){var isOpen=backdrop&&backdrop.classList.contains("is-open");if((ev.metaKey||ev.ctrlKey)&&ev.key.toLowerCase()==="k"){ev.preventDefault();openPalette()}else if(ev.key==="Escape"&&isOpen){closePalette()}else if(isOpen&&(ev.key==="ArrowDown"||ev.key==="ArrowUp"||ev.key==="Enter")){if(ev.key==="Enter"){var it=currentItems[selectedIdx];if(it&&it.href){ev.preventDefault();location.href=it.href}}else{ev.preventDefault();var delta=ev.key==="ArrowDown"?1:-1;selectedIdx=Math.max(0,Math.min(currentItems.length-1,selectedIdx+delta));renderSel()}}});function renderSel(){results.querySelectorAll(".command__item").forEach(function(el,i){el.classList.toggle("command__item--focused",i===selectedIdx)})}var searchT=null;if(input){input.addEventListener("input",function(){clearTimeout(searchT);if(spinner)spinner.hidden=false;searchT=setTimeout(function(){var q=input.value.trim();if(q.length<2){if(spinner)spinner.hidden=true;results.innerHTML=\'<div class="cms-search-hint">Keep typing...</div>\';currentItems=[];return}fetch("/admin/api/search?q="+encodeURIComponent(q),{headers:{Accept:"application/json"}}).then(function(r){return r.ok?r.json():{}}).then(function(j){if(spinner)spinner.hidden=true;var html="";currentItems=[];function add(label,meta,icon,href){currentItems.push({href:href});html+=\'<a class="command__item" href="\'+href+\'"><span class="command__item-icon">\'+icon+\'</span><span style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">\'+label+\'</span>\'+(meta?\'<span style="font-size:11px;color:rgba(255,255,255,0.5)">\'+meta+\'</span>\':\'\')+\'</a>\'}var ql=q.toLowerCase();function f(arr,fn){return(arr||[]).filter(fn).slice(0,5)}var pgs=f(j.pages,function(p){return(p.title||"").toLowerCase().includes(ql)||(p.slug||"").toLowerCase().includes(ql)});if(pgs.length){html+=\'<div class="command__group-label">Pages</div>\';pgs.forEach(function(p){add(p.title,\'/p/\'+p.slug,"P","/admin/pages/"+p.id)})}var bls=f(j.blocks,function(b){return JSON.stringify(b).toLowerCase().includes(ql)});if(bls.length){html+=\'<div class="command__group-label">Blocks</div>\';bls.forEach(function(b){add(b.type+" block","page "+(b.pageId||""),"B","/admin/blocks/"+b.type+"/"+b.id)})}var us=f(j.users,function(u){return(u.name||"").toLowerCase().includes(ql)||(u.email||"").toLowerCase().includes(ql)});if(us.length){html+=\'<div class="command__group-label">Users</div>\';us.forEach(function(u){add(u.name||u.email,u.email,"U","/admin/users/"+u.id)})}var md=f(j.media,function(m){return(m.filename||"").toLowerCase().includes(ql)});if(md.length){html+=\'<div class="command__group-label">Media</div>\';md.forEach(function(m){add(m.filename,"","M","/admin/media")})}results.innerHTML=html||\'<div class="cms-search-hint">No results for "\'+q+\'"</div>\';selectedIdx=0;renderSel()}).catch(function(){if(spinner)spinner.hidden=true})},220)})}});</script>'

  @raw '<script>window.cmsEscape=function(s){return String(s==null?"":s).replace(/[&<>"\\\']/g,function(c){return{"&":"&amp;","<":"&lt;",">":"&gt;","\\"":"&quot;","\\\'":"&#39;"}[c]})};window.cmsFmtDate=function(t){if(!t)return"";var d=new Date(t);if(isNaN(d.getTime()))return"";return d.toLocaleDateString()};window.cmsFmtRel=function(t){if(!t)return"";var ms=new Date(t).getTime();var ago=Math.floor((Date.now()-ms)/1000);if(ago<60)return ago+"s ago";var m=Math.floor(ago/60);if(m<60)return m+"m ago";var h=Math.floor(m/60);if(h<24)return h+"h ago";var d=Math.floor(h/24);if(d<7)return d+"d ago";return new Date(t).toLocaleDateString()};window.cmsFmtBytes=function(n){if(n==null)return"";var u=["B","KB","MB","GB"];var i=0;while(n>=1024&&i<u.length-1){n/=1024;i++}return n.toFixed(n<10&&i>0?1:0)+" "+u[i]};window.cmsEmpty=function(opts){var actionHtml=opts.href?\'<div class="empty-state__action"><a href="\'+opts.href+\'" class="btn btn--primary">\'+window.cmsEscape(opts.cta||"Create")+\'</a></div>\':"";return \'<div class="empty-state empty-state--card cms-empty-mount"><div class="empty-state__icon">\'+(opts.icon||"·")+\'</div><h2 class="empty-state__title">\'+window.cmsEscape(opts.title||"Nothing here yet")+\'</h2><p class="empty-state__body">\'+window.cmsEscape(opts.body||"")+\'</p>\'+actionHtml+\'</div>\'};window.cmsError=function(e){var msg=e===401?"You need to sign in again.":"Try refreshing the page.";return \'<div class="empty-state empty-state--card cms-empty-mount"><div class="empty-state__icon">!</div><h2 class="empty-state__title">Couldn&rsquo;t load data</h2><p class="empty-state__body">\'+msg+\'</p></div>\'};window.cmsList=function(opts){var root=document.querySelector(opts.root);if(!root)return;fetch(opts.source,{headers:{Accept:"application/json"}}).then(function(r){return r.ok?r.json():Promise.reject(r.status)}).then(function(j){var rows=opts.key?(j[opts.key]||[]):(j.rows||[]);var subtitle=document.querySelector(".cms-pageheader-subtitle");if(subtitle&&opts.totalLabel!==false)subtitle.textContent=(j.total!=null?j.total:rows.length)+(opts.totalLabel||" total");if(rows.length===0){root.innerHTML=window.cmsEmpty(opts.empty||{});if(opts.afterEmpty)opts.afterEmpty(root);return}root.innerHTML=opts.shell;var tgt=root.querySelector("[data-rows]");if(tgt)tgt.innerHTML=rows.map(opts.row).join("");if(opts.after)opts.after(rows,j,root)}).catch(function(e){root.innerHTML=window.cmsError(e)})};</script>'

  @raw '<style>.cms-list-skel{padding:8px 0}.cms-empty-mount{margin:32px 0;width:100%}.cms-page-stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px}.cms-stat{padding:18px;border-radius:14px;background:var(--ui-bg-2);border:1px solid var(--ui-border);display:flex;flex-direction:column;gap:6px;transition:transform .15s ease,border-color .15s ease}.cms-stat:hover{transform:translateY(-2px);border-color:var(--ui-accent)}.cms-stat__label{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.08em;color:var(--ui-fg-3,var(--ui-fg-2))}.cms-stat__value{font-size:28px;font-weight:800;letter-spacing:-.02em;color:var(--ui-fg);font-variant-numeric:tabular-nums}.cms-stat__hint{font-size:11px;color:var(--ui-fg-3,var(--ui-fg-2))}.cms-stat a{color:inherit;text-decoration:none;display:contents}.cms-media-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:12px}.cms-media-card{display:flex;flex-direction:column;background:var(--ui-bg-2);border:1px solid var(--ui-border);border-radius:10px;overflow:hidden;text-decoration:none;color:var(--ui-fg);transition:border-color .15s,transform .15s}.cms-media-card:hover{border-color:var(--ui-accent);transform:translateY(-1px)}.cms-media-thumb{aspect-ratio:4/3;background:var(--ui-bg-3);display:flex;align-items:center;justify-content:center;color:var(--ui-fg-3);font-size:32px}.cms-media-thumb img{width:100%;height:100%;object-fit:cover;display:block}.cms-media-meta{padding:8px 10px;font-size:11px;display:flex;flex-direction:column;gap:2px}.cms-media-name{font-weight:600;color:var(--ui-fg);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.cms-media-sub{color:var(--ui-fg-3,var(--ui-fg-2));font-variant-numeric:tabular-nums}</style>'

