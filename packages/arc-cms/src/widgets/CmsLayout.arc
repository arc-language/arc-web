  design
    body
      margin: 0
      font-family: -apple-system, BlinkMacSystemFont, 'Inter', system-ui, sans-serif
      font-size: 14px
      background-color: var(--ui-bg, #f0f7ff)
      color: var(--ui-fg, #050d1f)
      min-height: 100vh
