{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Arc",
  "scopeName": "source.arc",
  "patterns": [
    { "include": "#comments" },
    { "include": "#annotations" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#elements" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.arc",
          "match": "//.*$"
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "storage.modifier.annotation.arc",
          "match": "@(build|state|computed|live|realtime|server|worker|session|slot|field|attr|get|dark|mobile|tablet|desktop|container)\\b"
        },
        {
          "name": "variable.other.at.arc",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.arc",
          "match": "\\b(if|else|unless|until|while|for|in|match|return|break|continue|loop|try|new|is)\\b"
        },
        {
          "name": "keyword.declaration.arc",
          "match": "\\b(import|export|from|page|widget|design|class|extends|fn|const|let|static|type|async|await)\\b"
        },
        {
          "name": "constant.language.arc",
          "match": "\\b(true|false|none|Ok|Err)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.arc",
          "match": "\\b(String|Number|Boolean|Date|DateTime|Time|Array|Object|Result|Email|Url|Phone|PostalCode|Slug|Color|none|any)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.arc",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.arc",
              "match": "\\\\[ntr\\\\\"'{]"
            },
            {
              "name": "meta.embedded.expression.arc",
              "begin": "\\{",
              "end": "\\}",
              "patterns": [
                { "include": "$self" }
              ]
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.arc",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "elements": {
      "patterns": [
        {
          "name": "entity.name.tag.arc",
          "match": "^\\s*(page|widget|design|main|header|footer|nav|aside|article|section|card|row|col|grid|center|stack|spacer|divider|heading|text|span|link|img|input|select|textarea|button|form|table|cell|code|pre|video|audio|canvas|icon|modal|tooltip|accordion)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arc",
          "match": "(\\|>|\\?\\?|==|!=|<=|>=|->|=>|\\.\\.=|\\.\\.|[+\\-*/%<>!])"
        },
        {
          "name": "keyword.operator.assignment.arc",
          "match": "="
        }
      ]
    }
  }
}
